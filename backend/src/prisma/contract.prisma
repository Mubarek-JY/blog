// use prisma-8

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  password          String
  username          String
  name              String?
  posts             Post[]
  comments          Comment[]
  registeredAt      TimestamptzString @default(now())
}

model Post {
  id                Int      @id @default(autoincrement())
  title             String?
  content           String
  author            User     @relation(fields: [authorId], references: [id])
  authorId          Int
  comments          Comment[]
  postedAt          TimestamptzString @default(now())
}

model Comment {
  id                Int     @id @default(autoincrement())
  content           String
  post              Post    @relation(fields: [postId], references: [id])
  postId            Int
  author            User    @relation(fields: [authorId], references: [id])
  authorId          Int
  postedAt          TimestamptzString @default(now())
}
